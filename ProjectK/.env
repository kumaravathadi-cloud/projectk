# ═════════════════════════════════════════════════════════════════════════════
# ProjectK Backend Configuration
# ═════════════════════════════════════════════════════════════════════════════

# Environment (dev, staging, prod)
ENV=dev

# Server configuration
HOST=0.0.0.0
PORT=8000

# ═════════════════════════════════════════════════════════════════════════════
# AZURE OPENAI CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Get these values from Azure Portal → OpenAI resource
# https://portal.azure.com → Your OpenAI resource → Keys and Endpoint

# Azure OpenAI API Key (keep this secret!)
AZURE_OPENAI_API_KEY=sk-vsyHRMKgTEU5lPjeMTOPfA

# Azure OpenAI Endpoint (e.g., https://projectk.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://api.ai-gateway.tigeranalytics.com

# Azure OpenAI API Version (usually 2024-08-01-preview)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ═════════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Default agent (usually call_screener)
DEFAULT_AGENT=call_screener

# Agent model deployment name (should match Azure OpenAI deployment)
AGENT_MODEL_DEPLOYMENT=gpt-4.1

# ═════════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION (Optional - for session storage)
# ═════════════════════════════════════════════════════════════════════════════

# Redis connection URL
# Local: redis://localhost:6379
# Azure Cache for Redis: redis://:password@hostname:6379
REDIS_URL=redis://localhost:6379

# ═════════════════════════════════════════════════════════════════════════════
# EXOTEL CONFIGURATION (For phone integration - future)
# ═════════════════════════════════════════════════════════════════════════════

# Exotel SID (Account SID from Exotel dashboard)
EXOTEL_SID=yourexotelsid

# Exotel API Token
EXOTEL_TOKEN=yourexoteltoken

# Exotel API URL
EXOTEL_API_URL=https://api.exotel.com/v2

# ═════════════════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Insights connection string (optional)
APPINSIGHTS_INSTRUMENTATION_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# COMPANY CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Company name (used in agent greeting)
COMPANY_NAME=Your Company Name

# Company phone number
COMPANY_PHONE=+1-800-000-0000
